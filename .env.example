# Proxy de IA do evento. NUNCA commitar o .env real.
AI_PROXY_URL=https://ai-proxy.gogroupbr.com
AI_PROXY_TOKEN=cole_o_token_aqui
# nome do modelo como o proxy lista (abra http://localhost:8000/api/saude para ver os disponíveis)
AI_PROXY_MODELO=gpt-4o-mini
# formato da API do proxy: openai (padrão, /v1/chat/completions) ou anthropic (/v1/messages)
AI_PROXY_FORMATO=openai

# Modelo de transcrição de áudio do proxy (usado só em navegador sem reconhecimento de voz)
AI_PROXY_MODELO_AUDIO=whisper-1

# WhatsApp: SEM API da Meta. A gerente escaneia um QR code na tela dela e as decisões saem pelo número dela.
# Instale a ponte uma vez:  cd whatsapp && npm install   (precisa de Node 18+). O servidor liga a ponte sozinho.
# Número do analista (quem recebe), só dígitos com 55 e DDD (ex.: 55859XXXXXXXX). NUNCA commitar.
WHATSAPP_DESTINO=
# Opcional: WHATSAPP_SIMULAR=1 liga a ponte de mentira (QR falso) para ensaiar sem celular.

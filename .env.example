# Proxy de IA do evento. NUNCA commitar o .env real.
AI_PROXY_URL=https://ai-proxy.gogroupbr.com
AI_PROXY_TOKEN=cole_o_token_aqui
# nome do modelo como o proxy lista (abra http://localhost:8000/api/saude para ver os disponíveis)
AI_PROXY_MODELO=gpt-4o-mini
# formato da API do proxy: openai (padrão, /v1/chat/completions) ou anthropic (/v1/messages)
AI_PROXY_FORMATO=openai
